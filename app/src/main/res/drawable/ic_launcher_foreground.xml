<?xml version="1.0" encoding="utf-8"?>
<!-- 引力环：斜置 -24° 等宽椭圆环。前景画布 108dp，安全区为中央 66dp，
     环长轴（含描边）缩放后约 37vp ≈ 42dp ≈ 显示区 72dp 的 58%，与设计稿一致。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <group
        android:scaleX="0.55"
        android:scaleY="0.55"
        android:pivotX="48"
        android:pivotY="48">
        <group
            android:rotation="-24"
            android:pivotX="48"
            android:pivotY="48">
            <path
                android:pathData="M18,48 a30,12 0 1,0 60,0 a30,12 0 1,0 -60,0"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="8" />
        </group>
    </group>
</vector>

